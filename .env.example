# HuggingFace Token (rate limit)
# Получить: https://huggingface.co/settings/tokens
HF_TOKEN=

# Опционально: куда кэшировать модели
# HF_HOME=

# Опционально: параметры запуска (default: 127.0.0.1:8000)
# HOST=127.0.0.1
# PORT=8000

# P7.2: очистка output/
JST_OUTPUT_TTL_DAYS=7
JST_OUTPUT_MAX_MB=500

# P7.8: EN reference (5-30 sec clean English speech)
JST_REFERENCE_EN=output/merged_reference_en.wav

# ═══════════════════════════════════════════════════════════════
# SECURITY (REQUIRED for production)
# ═══════════════════════════════════════════════════════════════
# Admin token для POST /api/emergency/{stop,resume,restart} и POST /api/security/*
# Если пуст — emergency routes возвращают 503, security routes — 503.
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
JST_ADMIN_TOKEN=

# API key для непубличных endpoints (/api/batch, /api/stt, /api/synth, /ws/*)
# Если пуст в dev — открыто (WARNING в лог). В prod (JST_ENV=production) — 503.
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
JST_API_KEY=

# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
# dev | production
JST_ENV=dev

# ═══════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════
# Sentry DSN для observability (если пусто — observability disabled)
# JST_SENTRY_DSN=
# JST_SENTRY_TRACES_RATE=0.1

# Trusted hosts (через запятую). Пусто = все разрешены (dev).
# JST_TRUSTED_HOSTS=127.0.0.1,localhost

# CORS allowed origins (через запятую).
# JST_ALLOWED_ORIGINS=
