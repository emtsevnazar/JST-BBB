[run]
source = backend
omit =
    backend/tests/*
    */__pycache__/*
    */site-packages/*
    # v1.8.7: ML-движок, веса ~2GB + GPU. Покрывается только test_real_engine.py (skip без JST_REAL_ENGINE=1)
    backend/engine.py
    backend/services/clone_engine.py
    backend/main.py
    backend/core/config.py
    backend/core/auto_cleanup.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
