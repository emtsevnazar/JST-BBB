[run]
source = backend
omit =
    backend/tests/*
    */__pycache__/*
    */site-packages/*
    # v1.8.7: clone_engine требует реальных весов JST (~2GB) + GPU
    # Покрывается только E2E-тестом test_real_engine.py (skip без JST_REAL_ENGINE=1)
    backend/services/clone_engine.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
